{ The skill groups, TSkill.group's values; GDConsts' skillGroupNames, groupStart and groupEnd are indexed by them. }
unit C_Group;

interface

const
  { TSkill.group values, as skillGroupNames heads them; Skills lists the career's own skills as CAREER, and names group
    2, Constitution, which no skill is in }
  CAREER = 0;
  DEXTERITY = 1;
  INTELLIGENCE = 3;
  WISDOM = 4;
  CHARISMA = 5;
  TECHNICAL = 6;

implementation

end.
